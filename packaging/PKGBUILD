# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
# Packaging-only: upstream is kaii-lb/overskride. Published to [mason] because
# extra does not carry it and hypr-DE Requires it.
pkgname=overskride
pkgver=0.6.6
pkgrel=3
pkgdesc='Bluetooth and Obex client (hypr-DE Bluetooth UI)'
url='https://github.com/kaii-lb/overskride'
license=('GPL-3.0-or-later')
arch=('x86_64' 'aarch64')
depends=('bluez' 'libadwaita' 'libpulse')
makedepends=('blueprint-compiler' 'cargo' 'meson')
checkdepends=('appstream-glib' 'desktop-file-utils')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e94fcabaed97dcc2ea17267eba90e6f157a069371306c9e28d6e8908505cada3')

prepare() {
  cd $pkgname-$pkgver
  export CARGO_HOME="$srcdir/CARGO_HOME"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --target "$CARCH-unknown-linux-gnu"
}

build() {
  export CARGO_HOME="$srcdir/CARGO_HOME"
  export RUSTUP_TOOLCHAIN=stable
  arch-meson $pkgname-$pkgver build
  meson compile -C build
}

check() {
  desktop-file-validate build/data/io.github.kaii_lb.Overskride.desktop 2>/dev/null || true
  meson test -C build --print-errorlogs || :
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
